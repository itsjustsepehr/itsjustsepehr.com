---
import { categories, href } from "../lib/site";
---

<div class="topic-grid">
  {categories.map((c, i) => (
    <a
      data-reveal
      href={href(`categories/${c.slug}/`)}
      class:list={["topic-card", { "topic-card-wide": i === 0 }]}
    >
      <div class="topic-top">
        <span class="topic-number">0{i + 1} /</span>
        <span class="topic-arrow" aria-hidden="true">
          ↗
        </span>
      </div>
      <div>
        <h3>{c.name}</h3>
        <p>{c.description}</p>
      </div>
      {i === 0 && <span class="topic-orbit" aria-hidden="true" />}
    </a>
  ))}
</div>
