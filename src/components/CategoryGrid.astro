---
import { categories, href } from '../lib/site';
---
<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{categories.map((c, i) => <a data-reveal href={href(`categories/${c.slug}/`)} class="rounded-xl border border-border bg-surface p-6"><span class="mb-8 flex items-center justify-between text-xs text-ink-muted"><span>0{i + 1}</span><span aria-hidden="true">↗</span></span><h3 class="mb-3">{c.name}</h3><p class="text-sm text-ink-muted">{c.description}</p></a>)}</div>
