---
import HomeHero from '../components/HomeHero';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import CategoryGrid from '../components/CategoryGrid.astro';
import { publishedPosts } from '../lib/posts';
import { href } from '../lib/site';
const posts = (await publishedPosts()).slice(0, 4);
---
<Base title="itsjustsepehr">
  <HomeHero client:load writingHref={href('writing/')} aboutHref={href('about/')} />
  <section class="container section border-t border-border" aria-labelledby="writing-heading"><div class="mb-10 flex flex-wrap items-end justify-between gap-4"><div><p class="eyebrow mb-3">Notes from the work</p><h2 id="writing-heading">Latest writing</h2></div><a class="text-link text-sm" href={href('writing/')}>All writing →</a></div><div class="grid gap-8 md:grid-cols-2">{posts.map(post => <PostCard post={post} />)}</div></section>
  <section class="container section border-t border-border" aria-labelledby="categories-heading"><div class="mb-10" data-reveal><p class="eyebrow mb-3">Follow a thread</p><h2 id="categories-heading">A few things I think about.</h2></div><CategoryGrid /></section>
  <section class="container section border-t border-border grid gap-8 md:grid-cols-2" aria-labelledby="about-heading" data-reveal><div><p class="eyebrow mb-3">The person behind the code</p><h2 id="about-heading" class="max-w-[16ch]">Eight years of building. Always learning.</h2></div><div><p class="text-ink-muted">My work sits at the intersection of software engineering and banking systems. I care about reliability, clear decisions, and making complex systems easier to understand.</p><p class="mt-4 text-ink-muted">This is my space for sharing what I learn—in English and Persian.</p><div class="mt-6 flex flex-wrap gap-6"><a class="text-link" href={href('resume/')}>View résumé →</a><a class="text-link" href={href('portfolio/')}>Portfolio →</a></div></div></section>
</Base>
