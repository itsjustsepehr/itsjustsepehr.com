---
import Base from "../layouts/Base.astro";
import { href } from "../lib/site";
---

<Base title="Portfolio">
  <div class="container section">
    <div class="prose">
      <p class="eyebrow">Selected work</p>
      <h1>Portfolio</h1>
      <p class="text-xl text-ink-muted">
        A space for projects, decisions, and the lessons behind them.
      </p>
      <div class="my-12 rounded-xl border border-border bg-surface p-8">
        <h2 class="!mt-0">Case studies are on the way.</h2>
        <p>
          Public project details will be added here. In the meantime, explore
          the writing for practical examples and engineering notes.
        </p>
        <a class="text-link" href={href("writing/")}>
          Explore the writing →
        </a>
      </div>
    </div>
  </div>
</Base>
